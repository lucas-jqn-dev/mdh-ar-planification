# Copiar a .env y completar con valores reales. Nunca commitear .env.

NODE_ENV=development
PORT=3000

# Connection string de MongoDB Atlas (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/planification-mdh-team?retryWrites=true&w=majority

# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=reemplazar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=reemplazar-por-otro-secreto-aleatorio-distinto-de-al-menos-32-caracteres
JWT_REFRESH_EXPIRATION=7d

CORS_ORIGIN=http://localhost:4200

# Código que hay que ingresar en /signup para poder crear un usuario nuevo.
# Vacío/sin definir = alta pública deshabilitada.
SIGNUP_CODE=reemplazar-por-un-codigo-secreto-a-compartir-con-quien-deba-crear-cuentas

RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_TTL=60
AUTH_RATE_LIMIT_MAX=5

AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Usados solo por `npm run seed:admin` para crear el primer usuario ADMIN
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CambiarEstaPassword123!
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=Principal
